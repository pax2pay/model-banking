engine-strict=true
allow-file=none
allow-git=root
allow-remote=none
ignore-scripts=true
min-release-age=7
min-release-age-exclude[]=authly
min-release-age-exclude[]=cloudly-http
min-release-age-exclude[]=cryptly
min-release-age-exclude[]=gracely
min-release-age-exclude[]=isly
min-release-age-exclude[]=isoly
min-release-age-exclude[]=typedly
